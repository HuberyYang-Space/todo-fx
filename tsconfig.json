{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@huberyyang/todo-fx": ["./src/index.ts"],
      "@huberyyang/todo-fx/vue": ["./src/vue/index.ts"]
    },
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "playground", "*.config.ts"],
  "exclude": ["test/artifact/__snapshots__", "test/artifact/fixtures"]
}
